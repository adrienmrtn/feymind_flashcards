{
  "name": "micabo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node ./scripts/materialize-links.mjs || node ./web/scripts/materialize-links.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && pnpm --filter @micabo/core typecheck",
    "test": "pnpm --filter @micabo/core test && vitest run lib/import/docx.test.ts lib/import/youtube.test.ts lib/import/youtube-server.test.ts lib/onboarding/persist.test.ts lib/onboarding/steps.test.ts lib/open-courses.test.ts lib/auth/oauth.test.ts lib/stripe/checkout.test.ts lib/discount.test.ts lib/feedback.test.ts",
    "verify": "pnpm test && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@micabo/core": "workspace:*",
    "@paper-design/shaders-react": "0.0.80",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "thinking-orbs": "^0.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
