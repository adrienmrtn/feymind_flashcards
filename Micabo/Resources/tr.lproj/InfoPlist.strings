/*
  InfoPlist.strings — les quatre phrases que **le système** affiche, et pas l'app.

  Elles sortent des boîtes de dialogue d'iOS (appareil photo, photothèque, micro, dictée),
  qui suivent la langue du **téléphone** et non le sélecteur de Micabo : iOS les lit dans le
  bundle avant que la moindre ligne de Swift ne tourne. C'est la seule copie de l'app qui
  échappe à `L10n`, et c'est pour ça qu'elle est écrite ici plutôt que dans un catalogue.

  Le `Info.plist` porte l'anglais, la langue de base : c'est ce qui s'affiche quand le
  téléphone ne parle aucune des langues de Micabo. Chaque langue a son `.lproj`.
*/

"NSCameraUsageDescription" = "Micabo, ders sayfalarını taramak için kamerayı kullanır.";
"NSPhotoLibraryUsageDescription" = "Micabo, bir ders ya da şema içe aktarmak için fotoğraflarına erişir.";
"NSMicrophoneUsageDescription" = "Micabo, bir dersi veya sesli notu kaydedip derse dönüştürmek için mikrofonu kullanır.";
"NSSpeechRecognitionUsageDescription" = "Micabo, kayıtlarını derse dönüştürmek için telefonunda yazıya döker.";
