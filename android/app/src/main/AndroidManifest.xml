<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Le réseau : RevenueCat, Supabase. La permission BILLING (Google Play Billing) est
         ajoutée par le SDK RevenueCat, à la fusion des manifestes. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Le rappel avant la fin de l'essai gratuit (Android 13 et plus le demande). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Enregistrer son cours, pour en faire une leçon. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".MicaboApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Micabo">
        <!-- L'OCR de ML Kit : le modèle s'installe avec l'app, par les services Google Play. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Micabo.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".data.TrialReminderReceiver"
            android:exported="false" />
    </application>
</manifest>
