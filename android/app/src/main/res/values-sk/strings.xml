    <string name="ios_onb_review2_author">Noah · 2. ročník SŠ, Toronto</string>
    <string name="ios_onb_review2_body">Kartičky sa vrátia presne vtedy, keď som to už skoro zabudol. Za tri týždne som sa v dejepise zlepšil z trojky na jednotku.</string>
