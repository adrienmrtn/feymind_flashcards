    <string name="ios_onb_review4_author">Zoe · 1. ročník SŠ, Chicago</string>
    <string name="ios_onb_review4_body">Označím pasáž, ktorej nerozumiem, a dostanem jasné vysvetlenie na mojej úrovni. Strašne pomáha, keď sa zaseknem.</string>
    <string name="ios_onb_review4_title">Mika vysvetľuje, keď sa zaseknem</string>
