    <string name="ios_onb_review2_author">Pablo · 1.º de Bachillerato, Sevilla</string>
    <string name="ios_onb_review2_body">Las tarjetas vuelven justo cuando estaba a punto de olvidar. En tres semanas pasé de un 5 a un 8 en historia.</string>
