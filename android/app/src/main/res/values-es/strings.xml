    <string name="ios_onb_review3_author">Carmen · 2.º de Bachillerato, Valencia</string>
    <string name="ios_onb_review3_body">Le das la fecha y reparte el trabajo. Sabía qué repasar cada día en lugar de agobiarme la noche anterior.</string>
    <string name="ios_onb_review3_title">El plan antes de la selectividad vale oro</string>
